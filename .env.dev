TZ=UTC
NODE_ENV=development

O_DOLOG_STAGE=dev
O_DOLOG_TIMEZONE=${DOLOG_TIMEZONE}

X_DOLOG_ROOT=./opt/dolog
X_DOLOG_LOGGING=debug
X_DOLOG_DOCKER_SOCKET=${DOLOG_DOCKER_SOCKET}

X_DOLOG_THROTTLING_LOGS_PER_SECOND=${DOLOG_THROTTLING_LOGS_PER_SECOND}
X_DOLOG_RETENTION_TIME_WINDOW=1h
X_DOLOG_RETENTION_MAX_LINES=${DOLOG_RETENTION_MAX_LINES}

X_DOLOG_WEBHOOKS="app=https://dolog:secret@hooks.example.com/app db=https://hooks.example.com/db"
X_DOLOG_ALERTING_WEBHOOK_REF=${DOLOG_ALERTING_WEBHOOK_REF}
X_DOLOG_ALERTING_TEXT_PATTERN=${DOLOG_ALERTING_TEXT_PATTERN}
X_DOLOG_ALERTING_THROUGHPUT_THRESHOLD=${DOLOG_ALERTING_THROUGHPUT_THRESHOLD}
X_DOLOG_ALERTING_COOLDOWN_WINDOW=${DOLOG_ALERTING_COOLDOWN_WINDOW}
