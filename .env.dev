TZ=UTC
NODE_ENV=development

DOLOG_STAGE=dev
DOLOG_ROOT=./opt/dolog

# a value the operator provides always wins over this file; left empty, the default from `Env.Defaults` applies
DOLOG_TIMEZONE=
DOLOG_LOGGING=debug
DOLOG_DOCKER_SOCKET=

DOLOG_THROTTLING_LOGS_PER_SECOND=
DOLOG_RETENTION_TIME_WINDOW=1h
DOLOG_RETENTION_MAX_LINES=

DOLOG_WEBHOOKS="app=https://dolog:secret@hooks.example.com/app db=https://hooks.example.com/db"
DOLOG_ALERTING_WEBHOOK_REF=
DOLOG_ALERTING_TEXT_PATTERN=
DOLOG_ALERTING_THROUGHPUT_THRESHOLD=
DOLOG_ALERTING_COOLDOWN_WINDOW=
