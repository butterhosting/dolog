#!/bin/sh
set -eu

DOLOG_IMAGE="butterhosting/dolog"
DOLOG_PLATFORMS="linux/amd64,linux/arm64"

usage() {
    printf "Usage: %s <command> [arguments]\n" "$(basename "$0")"
    printf "\nCommands:\n"
    printf "  image create [options]     Build a production Docker image for this machine\n"
    printf "  image publish [options]    Build the image for all platforms and push it to Docker Hub\n"
    printf "\nOptions:\n"
    printf "  --stage <stage>            The .env.<stage> to bake in (default: prod)\n"
    exit 1
}

require_commands() {
    for cmd in "$@"; do
        if ! command -v "$cmd" >/dev/null 2>&1; then
            printf "Error: required command not found: %s\n" "$cmd"
            exit 1
        fi
    done
}

prepare_image() {
    stage="prod"

    while [ $# -gt 0 ]; do
        case "$1" in
            --stage)
                if [ $# -lt 2 ] || [ -z "$2" ] || case "$2" in -*) true;; *) false;; esac; then
                    printf "Error: --stage requires a value\n"
                    exit 1
                fi
                stage="$2"
                shift 2
                ;;
            *)
                printf "Error: unknown option '%s'\n\n" "$1"
                usage
                ;;
        esac
    done

    # Validate stage
    if [ ! -f ".env.${stage}" ]; then
        printf "Error: no .env.%s file found (available:" "$stage"
        for f in .env.*; do
            printf " %s" "${f#.env.}"
        done
        printf ")\n"
        exit 1
    fi

    tmpfile="./dist/dolog.Dockerfile"
    mkdir -p ./dist

    dolog_root=$(grep '^DOLOG_ROOT=' ".env.${stage}" | cut -d= -f2-)
    if [ -z "$dolog_root" ]; then
        printf "Error: DOLOG_ROOT not found in .env.%s\n" "$stage"
        exit 1
    fi

    commit=$(git rev-parse HEAD)

    # Determine version from git tags
    exact_tag=$(git tag --points-at HEAD | head -n 1)
    if [ -n "$exact_tag" ]; then
        version="$exact_tag"
    else
        closest_tag=$(git describe --tags --abbrev=0 2>/dev/null || true)
        if [ -n "$closest_tag" ]; then
            version="${closest_tag}-snapshot"
        else
            version="0.0.0"
        fi
    fi

    # Builder stage (shared)
    cat > "$tmpfile" <<'EOF'
FROM --platform=$BUILDPLATFORM oven/bun:alpine AS builder
WORKDIR /app
COPY package.json bun.lock* tsconfig.json bunfig.toml bun-env.d.ts drizzle.config.ts .env.* ./
ARG DOLOG_VERSION
ARG DOLOG_COMMIT
RUN bun -e "const p='./package.json'; const j=await Bun.file(p).json(); j.version='$DOLOG_VERSION'; j.commit='$DOLOG_COMMIT'; await Bun.write(p, JSON.stringify(j, null, 2))"
RUN bun install --frozen-lockfile --production
COPY src/ src/

FROM oven/bun:alpine
RUN apk update && apk add --no-cache bash sqlite
EOF
    # Check if dolog_root is an absolute path
    case "$dolog_root" in
        /*) is_absolute=true ;;
        *) is_absolute=false ;;
    esac

    if [ "$is_absolute" = true ]; then
        printf "RUN apk add --no-cache su-exec\n" >> "$tmpfile"
        printf "RUN mkdir -p %s && chown bun:bun %s\n" "$dolog_root" "$dolog_root" >> "$tmpfile"
        # The docker socket is root:<group> 0660, and that group's id is the host's to choose. So bun joins
        # whichever group owns the mounted socket; compose's group_add would not survive su-exec
        cat >> "$tmpfile" <<ENTRY_EOF
COPY --chmod=755 <<'ENTRYPOINT_SH' /entrypoint.sh
#!/bin/sh
set -eu
# a read-only mount inside the root (an .htpasswd, say) cannot be chowned, and does not need to be
chown -R bun:bun ${dolog_root} 2>/dev/null || true
socket="\${DOLOG_DOCKER_SOCKET:-/var/run/docker.sock}"
if [ -S "\$socket" ]; then
    gid=\$(stat -c %g "\$socket")
    group=\$(getent group "\$gid" | cut -d: -f1)
    if [ -z "\$group" ]; then
        group=dockersock
        addgroup -g "\$gid" "\$group"
    fi
    id -nG bun | tr ' ' '\n' | grep -qx "\$group" || addgroup bun "\$group"
fi
exec su-exec bun "\$@"
ENTRYPOINT_SH
ENTRY_EOF
    fi

    cat >> "$tmpfile" <<'EOF'
WORKDIR /app
COPY --from=builder --chown=bun:bun /app .
EOF

    if [ "$is_absolute" = true ]; then
        printf 'ENTRYPOINT ["/entrypoint.sh"]\n' >> "$tmpfile"
    else
        printf "USER bun\n" >> "$tmpfile"
    fi

    cat >> "$tmpfile" <<EOF
EXPOSE 3000
CMD ["bun", "start:${stage}"]
EOF
    printf "____________________\n%s\n--------------------\n" "$(cat $tmpfile)"

    tag="${DOLOG_IMAGE}:${version}"
    latest="${DOLOG_IMAGE}:latest"
    build_args="-f $tmpfile --build-arg DOLOG_VERSION=$version --build-arg DOLOG_COMMIT=$commit"

    # a prerelease (1.0.0-alpha.1) does not become `latest`; a snapshot is never pushed, so it always does
    case "$exact_tag" in
        *-*) tags="-t $tag" ;;
        *) tags="-t $tag -t $latest" ;;
    esac
}

cmd_image_create() {
    prepare_image "$@"

    printf "Building image > %s\n" "$tag"
    docker build $build_args $tags .
    printf "Created image > %s\n" "$tag"
}

# a multi-platform image cannot land in the local image store, so it is pushed as it is built
cmd_image_publish() {
    prepare_image "$@"

    printf "Publishing image > %s\n" "$tag"
    docker buildx build $build_args $tags --platform "$DOLOG_PLATFORMS" --push .
    printf "Published image > %s\n" "$tag"
}

# --- routing ---

require_commands git docker

if [ $# -lt 1 ]; then
    usage
fi

command="$1"
shift

case "$command" in
    image)
        case "${1:-}" in
            create) shift; cmd_image_create "$@" ;;
            publish) shift; cmd_image_publish "$@" ;;
            *)
                printf "Error: expected 'image create' or 'image publish'\n\n"
                usage
                ;;
        esac
        ;;
    *)
        printf "Error: unknown command '%s'\n\n" "$command"
        usage
        ;;
esac
